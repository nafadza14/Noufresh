{
  "rewrites": [
    {
      "source": "/api/wilayah/:path*",
      "destination": "https://wilayah.id/api/:path*"
    },
    {
      "source": "/((?!api|assets|favicon.ico).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/reminders/process",
      "schedule": "0 * * * *"
    }
  ]
}
